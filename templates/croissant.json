{
    "@context": {
      "@language": "en",
      "@vocab": "https://schema.org/"
    },
    "@type": "sc:Dataset",
    "name": "{{ title }}",
    "conformsTo": "http://mlcommons.org/croissant/1.0",
    "description": "{{ short_description }}",
    "citeAs": "{{ citation }}",
    {% if license and license != 'N/A' and license != '' %}
    "license": "https://data.aifarms.org/license/{{ dataset }}",
    {% endif %}
    "url": "https://data.aifarms.org/view/{{ dataset }}",
    "datePublished": "{{ created }}",
    "creator": [
      {%- for author in authors %}
      {
        "@type": "sc:Person",
        "name": "{{ author }}"
        {#- "email": "harm.devries@servicenow.com" #}
      {%- if loop.last %}
      }
      {%- else %}
      },
      {%- endif %}
      {%- endfor %}
    ],
    {% if (url and url != '') or (filesize and filesize != 'N/A' and filesize != '') %}
    "distribution": [
      {
        "@type": "cr:FileSet",
        "@id": "{{ dataset }}.zip",
        "contentUrl": "{{ url if url and url != '' else download_url }}",
        {% if filesize and filesize != 'N/A' and filesize != '' %}
        "contentSize": "{{ filesize }}",
        {% endif %}
        "encodingFormat": "application/x-zip-compressed"
      }
    ],
    {% endif %}
    "keywords": [
      {%- for keyword in keywords %}
      "{{ keyword }}"
      {%- if not loop.last %}
      ,
      {%- endif %}
      {%- endfor %}
    ]
}
